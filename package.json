{
  "name": "mail-assistant",
  "productName": "Mail Assistant",
  "version": "0.2.0",
  "private": true,
  "description": "Personal read-only mail summaries and reply drafts for Gmail",
  "main": "./out/main/index.js",
  "author": "Mail Assistant",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "postinstall": "install-electron",
    "dist": "node scripts/check-env.mjs && npm run build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@googleapis/calendar": "^20.2.0",
    "@googleapis/gmail": "^22.1.0",
    "better-sqlite3": "^13.2.0",
    "google-auth-library": "^11.3.4",
    "imapflow": "2.10.2",
    "mailparser": "3.14.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
